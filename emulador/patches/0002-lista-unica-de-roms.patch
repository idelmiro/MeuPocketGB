+#ifdef MEUPOCKETGB
+/* ==================== MEUPOCKETGB: SINGLE ROM LIST ====================
+ * Lists every .gb, .gbc and .zip found in the ROM folder (default /roms,
+ * or $GAMBATTE_ROMDIR) and in its direct subfolders (e.g. /roms/GB and
+ * /roms/GBC), sorted by name. Gambatte picks DMG or GBC mode by itself.
+ */
+
+static std::vector<std::string> mpgb_roms; // full paths, same order as the menu
+
+static std::string mpgb_romdir() {
+    const char *env = getenv("GAMBATTE_ROMDIR");
+    std::string dir = (env && *env) ? env : "/roms";
+    while (dir.size() > 1 && dir[dir.size() - 1] == '/')
+        dir.erase(dir.size() - 1);
+    return dir;
+}
+
+static bool mpgb_is_rom(const char *name) {
+    const char *ext = strrchr(name, '.');
+    if (!ext || ext == name)
+        return false;
+    return strcasecmp(ext, ".gb") == 0 || strcasecmp(ext, ".gbc") == 0
+        || strcasecmp(ext, ".zip") == 0;
+}
+
+static std::string mpgb_basename(const std::string &path) {
+    std::string::size_type slash = path.rfind('/');
+    return slash == std::string::npos ? path : path.substr(slash + 1);
+}
+
+static bool mpgb_less(const std::string &a, const std::string &b) {
+    return strcasecmp(mpgb_basename(a).c_str(), mpgb_basename(b).c_str()) < 0;
+}
+
+static void mpgb_scan(const std::string &dir, int depth) {
+    DIR *d = opendir(dir.c_str());
+    if (!d) {
+        printf("MeuPocketGB: cannot open %s\n", dir.c_str());
+        return;
+    }
+    struct dirent *e;
+    while ((e = readdir(d)) != NULL) {
+        if (e->d_name[0] == '.')
+            continue; // hidden files, ".", ".." and macOS "._" junk
+        std::string full = dir + "/" + e->d_name;
+        struct stat st;
+        if (stat(full.c_str(), &st) != 0)
+            continue;
+        if (S_ISDIR(st.st_mode)) {
+            if (depth > 0)
+                mpgb_scan(full, depth - 1);
+        } else if (S_ISREG(st.st_mode) && mpgb_is_rom(e->d_name)) {
+            mpgb_roms.push_back(full);
+        }
+    }
+    closedir(d);
+}
+
+static std::string mpgb_last_error; // shown as the list title after a failed load
+
+// Appends load errors to <ROM folder>/meupocketgb-erros.txt, readable from the PC.
+static void mpgb_log_error(const std::string &rom, const std::string &reason) {
+    std::string logpath = mpgb_romdir() + "/meupocketgb-erros.txt";
+    FILE *f = fopen(logpath.c_str(), "a");
+    if (!f)
+        return;
+    struct stat st;
+    long size = stat(rom.c_str(), &st) == 0 ? (long)st.st_size : -1;
+    fprintf(f, "%s | %s | %ld bytes\n", rom.c_str(), reason.c_str(), size);
+    fclose(f);
+    sync();
+}
+
+static void mpgb_callback_selected(menu_t *caller_menu) {
+    int idx = caller_menu->selected_entry;
+    if (idx < 0 || idx >= (int)mpgb_roms.size())
+        return;
+    playMenuSound_ok();
+    SDL_Delay(250);
+    if (gambatte_p->isLoaded()) {
+        if (stateautosave == 1) {
+            statesave_dms(0); //autosave state 0
+        }
+        gambatte_p->saveSavedata(); // keep the previous game's progress
+    }
+    std::string fullgamepath = mpgb_roms[idx];
+    struct stat romst;
+    if (stat(fullgamepath.c_str(), &romst) == 0 && romst.st_size < 0x150) {
+        // Empty or cut-off file (smaller than the cartridge header): almost
+        // always a copy that never reached the card because it was pulled
+        // out of the PC before the data was written. Gambatte would read
+        // garbage as the header, so say what really happened.
+        mpgb_log_error(fullgamepath, "arquivo vazio/incompleto: copie de novo e ejete o cartao no PC antes de tirar");
+        mpgb_last_error = "ROM VAZIA: RECOPIE";
+        printOverlay(mpgb_last_error.c_str());
+        caller_menu->quit = 1;
+        return;
+    }
+    gamename = mpgb_basename(fullgamepath);
+    currgamename = strip_Extension(gamename);
+    loadConfig();
+    gambatte::LoadRes const res = gambatte_p->load(fullgamepath.c_str(), 0 + 0 + 0, prefercgb);
+    if (res < 0) {
+        std::string reason = gambatte::to_string(res);
+        if (reason.empty()) {
+            char code[32];
+            snprintf(code, sizeof code, "codigo %d", (int)res);
+            reason = code;
+        }
+        printf("failed to load ROM: %s: %s\n", fullgamepath.c_str(), reason.c_str());
+        mpgb_log_error(fullgamepath, reason);
+        // short Portuguese text that fits the 20-column title line
+        if (res == gambatte::LOADRES_IO_ERROR)
+            mpgb_last_error = "ERRO DE LEITURA";
+        else if (res == gambatte::LOADRES_BAD_FILE_OR_UNKNOWN_MBC)
+            mpgb_last_error = "ROM INVALIDA";
+        else if (reason.find("Unsupported") == 0)
+            mpgb_last_error = "CARTUCHO NAO SUPORT.";
+        else
+            mpgb_last_error = "ERRO AO ABRIR ROM";
+        printOverlay(mpgb_last_error.c_str());
+        caller_menu->quit = 1; // reopen the list showing the error as its title
+    } else {
+        mpgb_last_error.clear();
+        showoverlay = -1; // drop any old message so it doesn't show over the game
+        clearAllCheats(); //clear all cheatcodes from menus
+        if (gambatte_p->isCgb()) {
+            gameiscgb = 1;
+            loadFilter(filtername);
+        } else {
+            gameiscgb = 0;
+            loadPalette(palname);
+        }
+        firstframe = 0; //reset the frame counter
+        if (stateautoload == 1) {
+            stateload_dms(0); //autoload state 0
+        }
+        forcemenuexit = 2;
+        caller_menu->quit = 1;
+    }
+}
+
+static int mpgb_last_selected = 0;
+
+static void mpgb_show_rom_list(menu_t *caller_menu) {
+    menu_t *menu;
+    menu_entry_t *menu_entry;
+
+    mpgb_roms.clear();
+    std::string romdir = mpgb_romdir();
+    mpgb_scan(romdir, 1);
+    std::sort(mpgb_roms.begin(), mpgb_roms.end(), mpgb_less);
+
+    menu = new_menu();
+    menu_set_header(menu, menu_main_title.c_str());
+    menu_set_title(menu, mpgb_last_error.empty() ? "Jogos" : mpgb_last_error.c_str());
+    menu->back_callback = callback_back;
+
+    if (mpgb_roms.empty()) {
+        menu_entry = new_menu_entry(0);
+        menu_entry_set_text(menu_entry, "Nenhuma ROM encontrada");
+        menu_add_entry(menu, menu_entry);
+        menu_entry->selectable = 0;
+        menu_entry = new_menu_entry(0);
+        std::string where = "Copie para " + romdir;
+        menu_entry_set_text(menu_entry, where.c_str());
+        menu_add_entry(menu, menu_entry);
+        menu_entry->selectable = 0;
+    } else {
+        for (std::size_t i = 0; i < mpgb_roms.size(); ++i) {
+            menu_entry = new_menu_entry(0);
+            menu_entry_set_text_no_ext(menu_entry, mpgb_basename(mpgb_roms[i]).c_str());
+            menu_add_entry(menu, menu_entry);
+            menu_entry->callback = mpgb_callback_selected;
+        }
+        if (mpgb_last_selected < (int)mpgb_roms.size())
+            menu->selected_entry = mpgb_last_selected;
+    }
+
+    menu_main(menu);
+    if (!mpgb_roms.empty())
+        mpgb_last_selected = menu->selected_entry;
+    delete_menu(menu);
+
+    if (forcemenuexit > 0 && caller_menu) {
+        menuout = 0;
+        caller_menu->quit = 1;
+    }
+}
+
+/* Called once at startup instead of main_menu(): shows the game list and
+ * keeps showing it until a game is loaded (B just refreshes the list, so
+ * newly copied ROMs show up without rebooting). */
+void rom_browser_startup() {
+    SDL_EnableKeyRepeat(250, 83);
+    switchToMenuAudio();
+    // boot-time marker in the kernel log, with the same clock as dmesg
+    FILE *kmsg = fopen("/dev/kmsg", "w");
+    if (kmsg) {
+        fputs("meupocketgb: lista de jogos na tela\n", kmsg);
+        fclose(kmsg);
+    }
+    while (!gambatte_p->isLoaded()) {
+        forcemenuexit = 0;
+        mpgb_show_rom_list(NULL);
+        if (!gambatte_p->isLoaded())
+            SDL_Delay(150);
+    }
+    switchToEmulatorAudio();
+    SDL_EnableKeyRepeat(0, 100);
+}
+#endif // MEUPOCKETGB
+
