MeuPocketGB: abre direto na lista de jogos (.gb e .gbc juntos)

Compilado com -DMEUPOCKETGB -DROM_BROWSER (Makefile.meupocketgb): ao
ligar mostra uma lista unica com as ROMs de /roms (ou $GAMBATTE_ROMDIR)
e das subpastas, sem menu principal nem escolha de sistema.

diff --git a/Makefile.meupocketgb b/Makefile.meupocketgb
new file mode 100644
index 0000000..41be70d
--- /dev/null
+++ b/Makefile.meupocketgb
@@ -0,0 +1,35 @@
+# MeuPocketGB: Gambatte-DMS for the PocketGo (v1)
+#  - opens straight into a single list with the .gb and .gbc games
+#  - writes the in-game save to the card a couple of seconds after the game saves
+#
+# Variables you can override on the command line:
+#   CROSS_COMPILE  toolchain prefix (default: MiyooCFW static musl SDK in /opt/miyoo)
+#   SDL_CONFIG     path to sdl-config of the target sysroot
+#   STATIC=1       link everything statically (runs on uClibc and musl MiyooCFW cards)
+#   STATIC=0       link against the shared libraries of the target (Buildroot image)
+
+CROSS_COMPILE ?= /opt/miyoo/bin/arm-miyoo-linux-musleabi-
+CC  = $(CROSS_COMPILE)gcc
+CXX = $(CROSS_COMPILE)g++
+SYSROOT    ?= $(shell $(CC) -print-sysroot 2>/dev/null)
+SDL_CONFIG ?= $(SYSROOT)/usr/bin/sdl-config
+SDL_CFLAGS := $(shell $(SDL_CONFIG) --cflags)
+
+STATIC     ?= 1
+OUTPUTNAME ?= gambatte-meupocketgb
+
+DEFINES  = -DHAVE_STDINT_H -DVERSION_POCKETGO -DROM_BROWSER -DMEUPOCKETGB $(EXTRA_DEFINES)
+INCLUDES = -Isrc/gambatte_sdl -Ilibgambatte -Icommon -Iinclude -Ilibgambatte/include -Ilibgambatte/src $(SDL_CFLAGS)
+OPT_FLAGS ?= -Ofast -fdata-sections -ffunction-sections -fno-common -fno-PIC -flto
+
+ifeq ($(STATIC),1)
+EXTRA_LDFLAGS = -static -lasound -lmikmod -ltiff -lwebp -lmpg123 -lmad -lts -Wl,--as-needed -Wl,--gc-sections -flto -s
+endif
+
+include common.mk
+
+ifneq ($(STATIC),1)
+# Shared build: only the libraries Gambatte really calls. libstdc++/libgcc go
+# inside the binary: resolving libstdc++.so symbols took ~0.4 s at every start.
+LDFLAGS = -lSDL -lSDL_image -lSDL_mixer -lz -lm -pthread -Wl,-Bstatic -lstdc++ -Wl,-Bdynamic -static-libgcc -Wl,--as-needed -Wl,--gc-sections $(EXTRA_LDFLAGS)
+endif
