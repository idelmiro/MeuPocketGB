+/* MeuPocketGB: minimalist menus drawn straight on the 320x240 screen.
+ * See mpgb_ui.h. Layout units follow a 320x240 grid: 10 px margins,
+ * 30 px rows, 30 px pills, hints row at y = 200.
+ */
+#include "mpgb_ui.h"
+#include "mpgb_fonte.h"
+
+#include <gambatte.h>
+#include "src/blitterwrapper.h"
+#include "menu.h"
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <fstream>
+#include <vector>
+
+extern void init_border(SDL_Surface *dst); // src/sdlblitter.cpp
+
+namespace {
+
+const int W = 320, H = 240;
+const Uint8 C_WHITE[3] = {255, 255, 255}, C_BLACK[3] = {0, 0, 0}, C_GRAY[3] = {40, 40, 40},
+            C_LIGHT[3] = {200, 200, 200}, C_DIM[3] = {130, 130, 130}, C_HELP[3] = {190, 190, 190},
+            C_LOW[3] = {255, 80, 80};
+
+/* ---------- pixels ---------- */
+
+inline Uint32 get_px(SDL_Surface *s, int x, int y) {
+	Uint8 *p = (Uint8 *)s->pixels + y * s->pitch + x * s->format->BytesPerPixel;
+	return s->format->BytesPerPixel == 2 ? *(Uint16 *)p : *(Uint32 *)p;
+}
+
+inline void set_px(SDL_Surface *s, int x, int y, Uint32 c) {
+	Uint8 *p = (Uint8 *)s->pixels + y * s->pitch + x * s->format->BytesPerPixel;
+	if (s->format->BytesPerPixel == 2)
+		*(Uint16 *)p = (Uint16)c;
+	else
+		*(Uint32 *)p = c;
+}
+
+// alpha 0..255; surface must be locked
+inline void blend(SDL_Surface *s, int x, int y, const Uint8 *c, int a) {
+	if (a <= 0 || x < 0 || y < 0 || x >= s->w || y >= s->h)
+		return;
+	if (a >= 255) {
+		set_px(s, x, y, SDL_MapRGB(s->format, c[0], c[1], c[2]));
+		return;
+	}
+	Uint8 r, g, b;
+	SDL_GetRGB(get_px(s, x, y), s->format, &r, &g, &b);
+	r += (c[0] - r) * a / 255;
+	g += (c[1] - g) * a / 255;
+	b += (c[2] - b) * a / 255;
+	set_px(s, x, y, SDL_MapRGB(s->format, r, g, b));
+}
+
+void fill(SDL_Surface *s, int x, int y, int w, int h, const Uint8 *c) {
+	SDL_Rect r = { (Sint16)x, (Sint16)y, (Uint16)w, (Uint16)h };
+	SDL_FillRect(s, &r, SDL_MapRGB(s->format, c[0], c[1], c[2]));
+}
+
+struct Lock {
+	SDL_Surface *s;
+	explicit Lock(SDL_Surface *s) : s(s) { if (SDL_MUSTLOCK(s)) SDL_LockSurface(s); }
+	~Lock() { if (SDL_MUSTLOCK(s)) SDL_UnlockSurface(s); }
+};
+
+// rounded rectangle with smooth edges; rad = h / 2 gives a pill
+void rrect(SDL_Surface *s, int x, int y, int w, int h, int rad, const Uint8 *c) {
+	if (w <= 0 || h <= 0)
+		return;
+	if (rad * 2 > h) rad = h / 2;
+	if (rad * 2 > w) rad = w / 2;
+	fill(s, x + rad, y, w - 2 * rad, h, c);        // middle band
+	fill(s, x, y + rad, rad, h - 2 * rad, c);       // left band
+	fill(s, x + w - rad, y + rad, rad, h - 2 * rad, c);
+	Lock lock(s);
+	for (int py = 0; py < h; ++py) {
+		if (py >= rad && py < h - rad)
+			continue;
+		float cy = py + 0.5f, ccy = cy < rad ? rad : h - rad;
+		for (int px = 0; px < w; ++px) {
+			if (px >= rad && px < w - rad)
+				continue;
+			float cx = px + 0.5f, ccx = cx < rad ? rad : w - rad;
+			float d = sqrtf((cx - ccx) * (cx - ccx) + (cy - ccy) * (cy - ccy));
+			float cov = rad - d + 0.5f;
+			if (cov > 0)
+				blend(s, x + px, y + py, c, cov >= 1 ? 255 : (int)(cov * 255));
+		}
+	}
+}
+
+/* ---------- text ---------- */
+
+const mpgb_glyph *glyph(const mpgb_font &f, unsigned cp) {
+	// tables are sorted: 32..126, 160..255, U+2026
+	if (cp >= 32 && cp <= 126) return &f.g[cp - 32];
+	if (cp >= 160 && cp <= 255) return &f.g[95 + cp - 160];
+	if (cp == 0x2026) return &f.g[f.n - 1];
+	return &f.g['?' - 32];
+}
+
+// UTF-8 (falls back to Latin-1 for stray bytes, e.g. names from a FAT card)
+std::vector<unsigned> decode(const std::string &s) {
+	std::vector<unsigned> out;
+	for (size_t i = 0; i < s.size();) {
+		unsigned char c = s[i];
+		if (c < 0x80) { out.push_back(c); ++i; continue; }
+		int n = (c & 0xE0) == 0xC0 ? 1 : (c & 0xF0) == 0xE0 ? 2 : (c & 0xF8) == 0xF0 ? 3 : -1;
+		unsigned cp = n == 1 ? c & 0x1F : n == 2 ? c & 0x0F : c & 0x07;
+		bool ok = n > 0 && i + n < s.size() + 1;
+		for (int k = 1; ok && k <= n; ++k) {
+			if (i + k >= s.size() || (s[i + k] & 0xC0) != 0x80) ok = false;
+			else cp = (cp << 6) | (s[i + k] & 0x3F);
+		}
+		if (ok) { out.push_back(cp); i += n + 1; }
+		else { out.push_back(c); ++i; }
+	}
+	return out;
+}
+
+int width(const mpgb_font &f, const std::vector<unsigned> &t) {
+	int w = 0;
+	for (size_t i = 0; i < t.size(); ++i) w += glyph(f, t[i])->adv;
+	return w;
+}
+
+int width(const mpgb_font &f, const std::string &s) { return width(f, decode(s)); }
+
+int cap_height(const mpgb_font &f) { return -glyph(f, 'H')->y; }
+
+// draws with the baseline at by; returns the advance
+int text_at(SDL_Surface *s, const mpgb_font &f, int x, int by, const std::vector<unsigned> &t, const Uint8 *c) {
+	Lock lock(s);
+	int pen = x;
+	for (size_t i = 0; i < t.size(); ++i) {
+		const mpgb_glyph *g = glyph(f, t[i]);
+		const uint8_t *px = f.px + g->off;
+		for (int yy = 0; yy < g->h; ++yy)
+			for (int xx = 0; xx < g->w; ++xx)
+				blend(s, pen + g->x + xx, by + g->y + yy, c, px[yy * g->w + xx]);
+		pen += g->adv;
+	}
+	return pen - x;
+}
+
+// text vertically centred in [y, y + h)
+int text(SDL_Surface *s, const mpgb_font &f, int x, int y, int h, const std::string &str, const Uint8 *c) {
+	return text_at(s, f, x, y + (h + cap_height(f) + 1) / 2, decode(str), c);
+}
+
+std::string fit(const mpgb_font &f, const std::string &str, int maxw) {
+	std::vector<unsigned> t = decode(str);
+	if (width(f, t) <= maxw)
+		return str;
+	int ell = glyph(f, 0x2026)->adv;
+	while (!t.empty() && width(f, t) + ell > maxw)
+		t.pop_back();
+	while (!t.empty() && t.back() == ' ')
+		t.pop_back();
+	std::string out;
+	for (size_t i = 0; i < t.size(); ++i) {
+		unsigned cp = t[i];
+		if (cp < 0x80) out += (char)cp;
+		else if (cp < 0x800) { out += (char)(0xC0 | (cp >> 6)); out += (char)(0x80 | (cp & 0x3F)); }
+		else { out += (char)(0xE0 | (cp >> 12)); out += (char)(0x80 | ((cp >> 6) & 0x3F)); out += (char)(0x80 | (cp & 0x3F)); }
+	}
+	return out + "\xE2\x80\xA6";
+}
+
+/* ---------- components ---------- */
+
+int battery_percent() {
+	static Uint32 last = 0;
+	static int pct = 100;
+	Uint32 now = SDL_GetTicks();
+	if (last && now - last < 5000)
+		return pct;
+	last = now ? now : 1;
+	FILE *f = fopen("/sys/class/power_supply/miyoo-battery/voltage_now", "r");
+	if (!f)
+		return pct;
+	int mv = 0;
+	if (fscanf(f, "%d", &mv) == 1 && mv > 0) {
+		if (mv > 100000) mv /= 1000; // reported in uV on some kernels
+		pct = (mv - 3300) * 100 / (4100 - 3300);
+		if (pct < 0) pct = 0;
+		if (pct > 100) pct = 100;
+	}
+	fclose(f);
+	return pct;
+}
+
+void battery(SDL_Surface *s) {
+	rrect(s, W - 40, 10, 30, 30, 15, C_GRAY);
+	int x = W - 34, y = 20, bw = 15, bh = 10;
+	const Uint8 *c = battery_percent() <= 15 ? C_LOW : C_WHITE;
+	fill(s, x, y, bw, 1, c);
+	fill(s, x, y + bh - 1, bw, 1, c);
+	fill(s, x, y, 1, bh, c);
+	fill(s, x + bw - 1, y, 1, bh, c);
+	fill(s, x + bw, y + 3, 2, 4, c);
+	int inner = (bw - 4) * battery_percent() / 100;
+	if (inner > 0)
+		fill(s, x + 2, y + 2, inner, bh - 4, c);
+}
+
+struct Hint { const char *key, *label; };
+
+// one dark pill with "[A] ABRIR [B] VOLTAR" style hints, right aligned (or left)
+void hints(SDL_Surface *s, const Hint *h, int n, bool right = true) {
+	const int pad = 4, gap = 8;
+	int total = pad * 2 + 6, kw[4];
+	for (int i = 0; i < n; ++i) {
+		kw[i] = strcmp(h[i].key, "<>") == 0 ? 30 : (width(mpgb_font_key, h[i].key) + 12 > 22 ? width(mpgb_font_key, h[i].key) + 12 : 22);
+		total += kw[i] + 4 + width(mpgb_font_hint, h[i].label) + (i ? gap : 0);
+	}
+	int x = right ? W - 10 - total : 10;
+	rrect(s, x, 200, total, 30, 15, C_GRAY);
+	x += pad;
+	for (int i = 0; i < n; ++i) {
+		rrect(s, x, 204, kw[i], 22, 11, C_LIGHT);
+		if (strcmp(h[i].key, "<>") == 0) {
+			Lock lock(s);
+			int cx = x + kw[i] / 2;
+			for (int col = 0; col < 5; ++col) // two small triangles: tips out, 6 px apart
+				for (int yy = -col; yy <= col; ++yy) {
+					blend(s, cx - 8 + col, 215 + yy, C_GRAY, 255);
+					blend(s, cx + 8 - col, 215 + yy, C_GRAY, 255);
+				}
+		} else {
+			int tw = width(mpgb_font_key, h[i].key);
+			text(s, mpgb_font_key, x + (kw[i] - tw) / 2, 204, 22, h[i].key, C_GRAY);
+		}
+		x += kw[i] + 4;
+		x += text(s, mpgb_font_hint, x, 200, 30, h[i].label, C_WHITE) + gap;
+	}
+}
+
+// keeps the selection inside the visible window; returns the first visible row
+int scroll(menu_t *m, int visible) {
+	if (m->mpgb_top > m->selected_entry) m->mpgb_top = m->selected_entry;
+	if (m->selected_entry >= m->mpgb_top + visible) m->mpgb_top = m->selected_entry - visible + 1;
+	if (m->mpgb_top > m->n_entries - visible) m->mpgb_top = m->n_entries - visible;
+	if (m->mpgb_top < 0) m->mpgb_top = 0;
+	return m->mpgb_top;
+}
+
+void rows(SDL_Surface *s, menu_t *m, int top, int visible, int x, int maxw, int rowh = 30) {
+	int first = scroll(m, visible);
+	for (int i = first; i < m->n_entries && i < first + visible; ++i) {
+		menu_entry_t *e = m->entries[i];
+		if (!e->text || !*e->text)
+			continue;
+		int y = top + (i - first) * rowh;
+		std::string t = fit(mpgb_font_item, e->text, maxw - 20);
+		if (i == m->selected_entry && e->selectable) {
+			rrect(s, x, y, width(mpgb_font_item, t) + 20, rowh, rowh / 2, C_WHITE);
+			text(s, mpgb_font_item, x + 10, y, rowh, t, C_BLACK);
+		} else {
+			text(s, mpgb_font_item, x + 10, y, rowh, t, e->selectable ? C_WHITE : C_DIM);
+		}
+	}
+}
+
+/* ---------- in-game background and save state preview ---------- */
+
+SDL_Surface *game_bg = 0;
+SDL_Surface *screen = 0; // set by menu_set_screen() whenever the video mode changes
+
+void preview(SDL_Surface *s, int slot) {
+	const int bx = W - 10 - 130, by = 50, bw = 130, bh = 132;
+	rrect(s, bx, by, bw, bh, 6, C_WHITE);
+	const int px = bx + 5, py = by + 5, pw = 120, ph = 108; // 80x72 thumbnail at 1.5x
+	uint32_t thumb[80 * 72];
+	std::ifstream file(getSaveStateFilename(slot).c_str(), std::ios_base::binary);
+	bool have = false;
+	if (file) {
+		file.ignore(5);
+		have = (bool)file.read(reinterpret_cast<char *>(thumb), sizeof thumb);
+	}
+	if (have) {
+		Lock lock(s);
+		for (int y = 0; y < ph; ++y)
+			for (int x = 0; x < pw; ++x) {
+				uint32_t v = thumb[(y * 2 / 3) * 80 + x * 2 / 3];
+				Uint8 c[3] = { (Uint8)(v >> 16), (Uint8)(v >> 8), (Uint8)v };
+				blend(s, px + x, py + y, c, 255);
+			}
+	} else {
+		fill(s, px, py, pw, ph, C_GRAY);
+		int tw = width(mpgb_font_hint, "Vazio");
+		text(s, mpgb_font_hint, px + (pw - tw) / 2, py, ph, "Vazio", C_DIM);
+	}
+	for (int i = 0; i < 10; ++i) { // slot dots
+		int cx = bx + 20 + i * 10, cy = by + bh - 9, r = i == slot ? 3 : 2;
+		rrect(s, cx - r, cy - r, r * 2, r * 2, r, i == slot ? C_BLACK : C_DIM);
+	}
+}
+
+/* ---------- screens ---------- */
+
+void draw_roms(SDL_Surface *s, menu_t *m) {
+	rows(s, m, 10, 6, 10, 270);
+	battery(s);
+	bool error = m->title && *m->title && strcmp(m->title, "Jogos") != 0;
+	if (error) { // load error: a light pill bottom-left with the reason
+		std::string t = fit(mpgb_font_hint, m->title, 150);
+		int tw = width(mpgb_font_hint, t);
+		rrect(s, 10, 200, tw + 20, 30, 15, C_LIGHT);
+		text(s, mpgb_font_hint, 20, 200, 30, t, C_BLACK);
+	} else if (m->n_entries > 0 && m->entries[0]->selectable) {
+		char buf[24];
+		snprintf(buf, sizeof buf, "%d/%d", m->selected_entry + 1, m->n_entries);
+		text(s, mpgb_font_hint, 14, 200, 30, buf, C_DIM);
+	}
+	if (gambatte_p->isLoaded()) {
+		Hint h[] = { { "B", "VOLTAR" }, { "A", "ABRIR" } };
+		hints(s, h, 2);
+	} else {
+		Hint h[] = { { "A", "ABRIR" } };
+		hints(s, h, 1);
+	}
+}
+
+void draw_game(SDL_Surface *s, menu_t *m) {
+	if (game_bg)
+		SDL_BlitSurface(game_bg, NULL, s, NULL);
+	std::string title = fit(mpgb_font_item, m->title ? m->title : "", W - 80);
+	rrect(s, 10, 10, width(mpgb_font_item, title) + 20, 30, 15, C_BLACK);
+	text(s, mpgb_font_item, 20, 10, 30, title, C_WHITE);
+	battery(s);
+	rows(s, m, 46, 5, 10, 165);
+	menu_entry_t *e = m->entries[m->selected_entry];
+	if (e->mpgb_slot)
+		preview(s, e->selected_entry);
+	if (e->mpgb_slot) {
+		Hint h[] = { { "<>", "ESCOLHER" }, { "A", "OK" } };
+		hints(s, h, 2);
+	} else {
+		Hint h[] = { { "B", "VOLTAR" }, { "A", "OK" } };
+		hints(s, h, 2);
+	}
+}
+
+void draw_options(SDL_Surface *s, menu_t *m) {
+	const char *title = m->title ? m->title : "";
+	while (*title == ' ') ++title;
+	std::string t(title);
+	while (!t.empty() && t[t.size() - 1] == ' ') t.erase(t.size() - 1);
+	text(s, mpgb_font_item, (W - width(mpgb_font_item, t)) / 2, 10, 30, t, C_WHITE);
+	battery(s);
+	const int top = 44, rowh = 24, visible = 5, x0 = 30, x1 = W - 30;
+	int first = scroll(m, visible);
+	for (int i = first; i < m->n_entries && i < first + visible; ++i) {
+		menu_entry_t *e = m->entries[i];
+		int y = top + (i - first) * rowh;
+		bool sel = i == m->selected_entry;
+		std::string value = e->is_shiftable && e->n_entries > 0 ? e->entries[e->selected_entry] : "";
+		int vw = value.empty() ? 0 : width(mpgb_font_hint, value) + 10;
+		std::string label = fit(mpgb_font_item, e->text ? e->text : "", x1 - x0 - 20 - vw);
+		if (sel) {
+			if (!value.empty())
+				rrect(s, x0, y, x1 - x0, rowh, rowh / 2, C_GRAY);
+			rrect(s, x0, y, width(mpgb_font_item, label) + 20, rowh, rowh / 2, C_WHITE);
+		}
+		text(s, mpgb_font_item, x0 + 10, y, rowh, label, sel ? C_BLACK : C_WHITE);
+		if (!value.empty())
+			text(s, mpgb_font_hint, x1 - 10 - width(mpgb_font_hint, value), y, rowh, value, C_WHITE);
+	}
+	menu_entry_t *e = m->entries[m->selected_entry];
+	if (e->mpgb_help) {
+		std::string help = fit(mpgb_font_hint, e->mpgb_help, W - 20);
+		text(s, mpgb_font_hint, (W - width(mpgb_font_hint, help)) / 2, 166, 30, help, C_HELP);
+	}
+	if (e->is_shiftable) {
+		Hint h[] = { { "B", "VOLTAR" }, { "<>", "MUDAR" } };
+		hints(s, h, 2);
+	} else {
+		Hint h[] = { { "B", "VOLTAR" }, { "A", "OK" } };
+		hints(s, h, 2);
+	}
+}
+
+void draw_list(SDL_Surface *s, menu_t *m) {
+	const char *title = m->title ? m->title : "";
+	while (*title == ' ') ++title;
+	std::string t(title);
+	while (!t.empty() && t[t.size() - 1] == ' ') t.erase(t.size() - 1);
+	if (!t.empty()) {
+		t = fit(mpgb_font_item, t, W - 80);
+		rrect(s, 10, 10, width(mpgb_font_item, t) + 20, 30, 15, C_GRAY);
+		text(s, mpgb_font_item, 20, 10, 30, t, C_WHITE);
+	}
+	battery(s);
+	rows(s, m, 46, 5, 10, W - 20);
+	Hint h[] = { { "B", "VOLTAR" }, { "A", "OK" } };
+	hints(s, h, 2);
+}
+
+} // namespace
+
+void mpgb_ui_set_screen(SDL_Surface *s) { screen = s; }
+
+void mpgb_ui_draw(SDL_Surface *s, menu_t *menu) {
+	SDL_FillRect(s, NULL, SDL_MapRGB(s->format, 0, 0, 0));
+	if (!menu || menu->n_entries <= 0)
+		return;
+	switch (menu->mpgb_kind) {
+	case MPGB_KIND_ROMS: draw_roms(s, menu); break;
+	case MPGB_KIND_GAME: draw_game(s, menu); break;
+	case MPGB_KIND_OPTIONS: draw_options(s, menu); break;
+	default: draw_list(s, menu); break;
+	}
+}
+
+void mpgb_ui_capture_game() {
+	if (!screen)
+		return;
+	if (!game_bg || game_bg->format->BitsPerPixel != screen->format->BitsPerPixel) {
+		if (game_bg)
+			SDL_FreeSurface(game_bg);
+		SDL_PixelFormat *f = screen->format;
+		game_bg = SDL_CreateRGBSurface(SDL_SWSURFACE, W, H, f->BitsPerPixel, f->Rmask, f->Gmask, f->Bmask, 0);
+		if (!game_bg)
+			return;
+	}
+	BlitterWrapper::Buf buf = blitter_p->inBuf();
+	Lock lock(game_bg);
+	// GB frame 160x144 at 2x, cropped to 240 lines, at 30% of the brightness
+	for (int y = 0; y < H; ++y) {
+		const gambatte::uint_least32_t *line = buf.pixels + ((y + 24) / 2) * buf.pitch;
+		for (int x = 0; x < W; ++x) {
+			uint32_t v = line[x / 2];
+			set_px(game_bg, x, y, SDL_MapRGB(game_bg->format, ((v >> 16) & 0xFF) * 30 / 100,
+			                                 ((v >> 8) & 0xFF) * 30 / 100, (v & 0xFF) * 30 / 100));
+		}
+	}
+}
+
+void mpgb_ui_restore_game_screen() {
+	if (!screen)
+		return;
+	for (int i = 0; i < 3; ++i) { // the screen may be double or triple buffered
+		init_border(screen);
+		SDL_Flip(screen);
+	}
+}
+
+std::string mpgb_display_name(const std::string &file) {
+	std::string n = file;
+	std::string::size_type slash = n.rfind('/');
+	if (slash != std::string::npos)
+		n = n.substr(slash + 1);
+	std::string::size_type dot = n.rfind('.');
+	if (dot != std::string::npos && dot > 0)
+		n = n.substr(0, dot);
+	std::string out; // drop "(USA, Europe)", "[T-En ...]" and similar tags
+	int depth = 0;
+	for (size_t i = 0; i < n.size(); ++i) {
+		char c = n[i];
+		if (c == '(' || c == '[') { ++depth; continue; }
+		if ((c == ')' || c == ']') && depth > 0) { --depth; continue; }
+		if (depth == 0)
+			out += c;
+	}
+	std::string clean; // collapse spaces
+	for (size_t i = 0; i < out.size(); ++i)
+		if (!(out[i] == ' ' && (clean.empty() || clean[clean.size() - 1] == ' ')))
+			clean += out[i];
+	while (!clean.empty() && clean[clean.size() - 1] == ' ')
+		clean.erase(clean.size() - 1);
+	if (clean.empty())
+		return n;
+	// "Legend of Zelda, The - Link's Awakening" -> "The Legend of Zelda - Link's Awakening"
+	const char *arts[] = { ", The", ", A", ", An" };
+	for (int k = 0; k < 3; ++k) {
+		std::string a = arts[k];
+		std::string::size_type at = clean.find(a);
+		if (at == std::string::npos)
+			continue;
+		std::string::size_type end = at + a.size();
+		if (end == clean.size() || clean.compare(end, 3, " - ") == 0) {
+			clean = a.substr(2) + " " + clean.substr(0, at) + clean.substr(end);
+			break;
+		}
+	}
+	return clean;
+}
+
+#ifdef MPGB_TEST
+/* PC tests only (compiled with -DMPGB_TEST, never in the firmware):
+ *   MPGB_TECLAS="ESPERA:120,MENU,BAIXO,A,..."  keys fed one per call
+ *   MPGB_CAPTURAS=/folder                      every menu redraw saved as BMP
+ * Keys: CIMA BAIXO ESQ DIREITA A B MENU START SELECT FIM; ESPERA:n skips n calls.
+ */
+void mpgb_test_feed_keys() {
+	static std::vector<std::string> keys;
+	static size_t pos = 0;
+	static int wait = 0;
+	static bool loaded = false;
+	if (!loaded) {
+		loaded = true;
+		const char *env = getenv("MPGB_TECLAS");
+		std::string s = env ? env : "", cur;
+		for (size_t i = 0; i <= s.size(); ++i) {
+			if (i == s.size() || s[i] == ',') { if (!cur.empty()) keys.push_back(cur); cur.clear(); }
+			else cur += s[i];
+		}
+	}
+	if (wait > 0) { --wait; return; }
+	if (pos >= keys.size())
+		return;
+	std::string k = keys[pos++];
+	if (k.compare(0, 7, "ESPERA:") == 0) { wait = atoi(k.c_str() + 7); return; }
+	if (k == "FIM") { SDL_Event q; q.type = SDL_QUIT; SDL_PushEvent(&q); return; }
+	SDLKey sym = k == "CIMA" ? SDLK_UP : k == "BAIXO" ? SDLK_DOWN : k == "ESQ" ? SDLK_LEFT : k == "DIREITA" ? SDLK_RIGHT
+	           : k == "A" ? SDLK_LALT : k == "B" ? SDLK_LCTRL : k == "MENU" ? SDLK_RCTRL : k == "START" ? SDLK_RETURN
+	           : k == "SELECT" ? SDLK_ESCAPE : SDLK_UNKNOWN;
+	if (sym == SDLK_UNKNOWN)
+		return;
+	SDL_Event e;
+	memset(&e, 0, sizeof e);
+	e.type = SDL_KEYDOWN; e.key.state = SDL_PRESSED; e.key.keysym.sym = sym;
+	SDL_PushEvent(&e);
+	e.type = SDL_KEYUP; e.key.state = SDL_RELEASED;
+	SDL_PushEvent(&e);
+}
+
+void mpgb_test_capture(SDL_Surface *s) {
+	static int n = 0;
+	const char *dir = getenv("MPGB_CAPTURAS");
+	if (!dir)
+		return;
+	char path[512];
+	snprintf(path, sizeof path, "%s/tela-%03d.bmp", dir, n++);
+	SDL_SaveBMP(s, path);
+}
+#endif
