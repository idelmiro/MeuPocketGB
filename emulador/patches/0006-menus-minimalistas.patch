+/* MeuPocketGB: minimalist menus drawn straight on the 320x240 screen
+ * (black background, white text, the selected item in a white pill, button
+ * hints at the bottom). Look inspired by MinUI; all code and the Nunito font
+ * (SIL OFL 1.1) are our own / freely licensed.
+ */
+#ifndef MPGB_UI_H
+#define MPGB_UI_H
+
+#include <SDL/SDL.h>
+#include <string>
+#include "libmenu.h"
+
+// menu_t::mpgb_kind
+enum {
+	MPGB_KIND_LIST = 0,    // generic list with a title pill (cheats, confirmations...)
+	MPGB_KIND_ROMS = 1,    // the game list
+	MPGB_KIND_GAME = 2,    // in-game menu over the paused game, save state preview
+	MPGB_KIND_OPTIONS = 3  // label + value changed with left/right, help line
+};
+
+// Screen surface (menu_set_screen passes it on).
+void mpgb_ui_set_screen(SDL_Surface *s);
+// Draws the whole menu screen (does not flip).
+void mpgb_ui_draw(SDL_Surface *s, menu_t *menu);
+// Keeps a darkened copy of the paused game as the in-game menu background.
+void mpgb_ui_capture_game();
+// After a menu closes: clear the leftover menu pixels and repaint the border.
+void mpgb_ui_restore_game_screen();
+// "Legend of Zelda, The - Link's Awakening DX (USA, Europe) (Rev A).gbc"
+//   -> "The Legend of Zelda - Link's Awakening DX"
+std::string mpgb_display_name(const std::string &file);
+
+#ifdef MPGB_TEST
+void mpgb_test_feed_keys();
+void mpgb_test_capture(SDL_Surface *s);
+#endif
+
+#endif
