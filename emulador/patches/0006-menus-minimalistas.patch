 /* Called once at startup instead of main_menu(): shows the game list and
  * keeps showing it until a game is loaded (B just refreshes the list, so
  * newly copied ROMs show up without rebooting). */
+/* ==================== MEUPOCKETGB: IN-GAME MENU AND OPTIONS (mpgb_ui) ====================
+ * In-game menu: Continuar / Salvar / Carregar / Opções / Sair, drawn over the
+ * paused game. On Salvar/Carregar, left/right picks the state slot and the
+ * preview shows it. Opções: every setting is one line, its value changed with
+ * left/right and applied at once; saved as default when leaving.
+ */
+static void callback_return(menu_t *caller_menu);
+static void callback_restart(menu_t *caller_menu);
+static void callback_cheats(menu_t *caller_menu);
+static void callback_loadgame(menu_t *caller_menu);
+
+static int mpgb_slot_now = 0;
+static bool mpgb_back_to_game = false; // an option (restart) asked to close every menu
+
+static void mpgb_cb_sync_slot(menu_t *menu) { // Salvar and Carregar share the slot
+    mpgb_slot_now = menu->entries[menu->selected_entry]->selected_entry;
+    for (int i = 0; i < menu->n_entries; ++i)
+        if (menu->entries[i]->mpgb_slot)
+            menu->entries[i]->selected_entry = mpgb_slot_now;
+}
+
+static void mpgb_cb_save(menu_t *menu) {
+    mpgb_slot_now = menu->entries[menu->selected_entry]->selected_entry;
+    playMenuSound_ok();
+    statesave_dms(mpgb_slot_now);
+    callback_return(menu);
+}
+
+static void mpgb_cb_load(menu_t *menu) {
+    mpgb_slot_now = menu->entries[menu->selected_entry]->selected_entry;
+    playMenuSound_ok();
+    stateload_dms(mpgb_slot_now);
+    callback_return(menu);
+}
+
+static void mpgb_cb_quit(menu_t *menu) {
+    mpgb_save_resume_state(); // the game continues from here if picked again
+    callback_loadgame(menu);
+}
+
+/* ---- options ---- */
+
+struct MpgbOption {
+    std::vector<std::string> values; // internal values (what the settings store)
+    void (*apply)(const std::string &value, int index);
+};
+static std::vector<MpgbOption> mpgb_opts; // same order as the options menu entries
+
+static void mpgb_apply_scaler(const std::string &v, int) {
+    selectedscaler = v;
+    if (gameiscgb == 0) {
+        loadPalette(palname);
+        load_border(dmgbordername);
+    } else {
+        load_border(gbcbordername);
+    }
+    blitter_p->setScreenRes();
+}
+static void mpgb_apply_palette(const std::string &v, int) {
+    palname = v;
+    loadPalette(palname);
+    if (gameiscgb == 0)
+        load_border(dmgbordername);
+}
+static void mpgb_apply_filter(const std::string &v, int) { filtername = v; loadFilter(filtername); }
+static void mpgb_apply_dmgborder(const std::string &v, int) {
+    dmgbordername = v;
+    if (gameiscgb == 0)
+        load_border(dmgbordername);
+}
+static void mpgb_apply_gbcborder(const std::string &v, int) {
+    gbcbordername = v;
+    if (gameiscgb == 1)
+        load_border(gbcbordername);
+}
+static void mpgb_apply_system(const std::string &, int i) { prefercgb = i; }
+static void mpgb_apply_ghosting(const std::string &, int i) { ghosting = i; }
+static void mpgb_apply_bios(const std::string &, int i) { biosenabled = i; }
+static void mpgb_apply_sound(const std::string &, int i) { stereosound = i; }
+static void mpgb_apply_buttons(const std::string &, int i) { buttonlayout = i; refreshkeys = 1; }
+static void mpgb_apply_fps(const std::string &, int i) { showfps = i; }
+
+static void mpgb_cb_option_shift(menu_t *menu) {
+    int i = menu->selected_entry;
+    if (i < 0 || i >= (int)mpgb_opts.size() || !mpgb_opts[i].apply)
+        return;
+    menu_entry_t *e = menu->entries[i];
+    mpgb_opts[i].apply(mpgb_opts[i].values[e->selected_entry], e->selected_entry);
+}
+
+// files of a settings folder, e.g. ~/.gambatte/palettes/*.pal
+static std::vector<std::string> mpgb_list_files(const char *sub, int (*filter)(const struct dirent *)) {
+    std::vector<std::string> out;
+    std::string dir = homedir + "/.gambatte/" + sub;
+    struct dirent **list = NULL;
+    int n = scandir(dir.c_str(), &list, filter, alphasort);
+    for (int i = 0; i < n; ++i) {
+        out.push_back(list[i]->d_name);
+        free(list[i]);
+    }
+    if (n >= 0)
+        free(list);
+    return out;
+}
+
+static void mpgb_add_option(menu_t *menu, const char *label, const char *help,
+                            const std::vector<std::string> &shown, const std::vector<std::string> &values,
+                            const std::string &current, void (*apply)(const std::string &, int)) {
+    menu_entry_t *e = new_menu_entry(1);
+    menu_entry_set_text(e, label);
+    for (size_t i = 0; i < shown.size(); ++i)
+        menu_entry_add_entry(e, shown[i].c_str());
+    e->selected_entry = 0;
+    for (size_t i = 0; i < values.size(); ++i)
+        if (values[i] == current)
+            e->selected_entry = (int)i;
+    e->mpgb_help = help;
+    e->mpgb_on_shift = mpgb_cb_option_shift;
+    menu_add_entry(menu, e);
+    MpgbOption o = { values, apply };
+    mpgb_opts.push_back(o);
+}
+
+static void mpgb_add_choice(menu_t *menu, const char *label, const char *help, const char *const *shown,
+                            int n, int current, void (*apply)(const std::string &, int)) {
+    std::vector<std::string> s, v;
+    for (int i = 0; i < n; ++i) {
+        s.push_back(shown[i]);
+        char num[8];
+        snprintf(num, sizeof num, "%d", i);
+        v.push_back(num);
+    }
+    char cur[8];
+    snprintf(cur, sizeof cur, "%d", current);
+    mpgb_add_option(menu, label, help, s, v, cur, apply);
+}
+
+static void mpgb_add_action(menu_t *menu, const char *label, const char *help, void (*callback)(menu_t *)) {
+    menu_entry_t *e = new_menu_entry(0);
+    menu_entry_set_text(e, label);
+    e->mpgb_help = help;
+    e->callback = callback;
+    menu_add_entry(menu, e);
+    MpgbOption o = { std::vector<std::string>(), NULL };
+    mpgb_opts.push_back(o);
+}
+
+static void mpgb_cb_restart(menu_t *menu) {
+    callback_restart(menu);
+    mpgb_back_to_game = true;
+}
