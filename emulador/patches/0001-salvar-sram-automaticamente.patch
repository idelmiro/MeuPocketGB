+#!/bin/sh
+# Compiles libgambatte for the PC and runs tests/autosave_test.cpp.
+# Usage: tests/run_autosave_test.sh path/to/rom_with_battery.gbc
+set -e
+cd "$(dirname "$0")/.."
+ROM="${1:?informe uma ROM com bateria, ex.: ucity.gbc}"
+OUT=$(mktemp -d)
+SRC=$(find libgambatte/src -name '*.cpp' ! -name 'file_zip.cpp' ! -path '*/unzip/*')
+${CXX:-g++} -std=gnu++11 -O1 -DHAVE_STDINT_H -Ilibgambatte/include -Ilibgambatte/src -Icommon \
+	tests/autosave_test.cpp $SRC -o "$OUT/autosave_test"
+"$OUT/autosave_test" "$ROM" "$OUT"
