diff --git a/tests/autosave_test.cpp b/tests/autosave_test.cpp
new file mode 100644
index 0000000..8de7414
--- /dev/null
+++ b/tests/autosave_test.cpp
@@ -0,0 +1,74 @@
+// MeuPocketGB: checks the save-on-change logic of libgambatte on the PC.
+// Build/run with tests/run_autosave_test.sh (uses a ROM with battery SRAM).
+#include "mem/cartridge.h"
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <sys/stat.h>
+#include <unistd.h>
+
+using namespace gambatte;
+
+static int failures = 0;
+#define CHECK(cond) do { if (!(cond)) { std::printf("FALHOU: %s (linha %d)\n", #cond, __LINE__); ++failures; } \
+                         else std::printf("ok: %s\n", #cond); } while (0)
+
+static long fileSize(std::string const &p) {
+	struct stat st;
+	return stat(p.c_str(), &st) == 0 ? (long)st.st_size : -1;
+}
+
+static int byteAt(std::string const &p, long off) {
+	std::FILE *f = std::fopen(p.c_str(), "rb");
+	if (!f) return -1;
+	std::fseek(f, off, SEEK_SET);
+	int c = std::fgetc(f);
+	std::fclose(f);
+	return c;
+}
+
+static void loadCart(Cartridge &c, char const *rom, std::string const &dir) {
+	c.setSaveDir(dir);
+	LoadRes r = c.loadROM(rom, false, false, 0);
+	if (r != LOADRES_OK) { std::printf("nao abriu a ROM %s\n", rom); std::exit(2); }
+	c.loadSavedata();
+}
+
+int main(int argc, char **argv) {
+	if (argc < 3) { std::printf("uso: %s rom_com_bateria.gbc pasta_saves/\n", argv[0]); return 2; }
+	char const *rom = argv[1];
+	std::string dir = argv[2];
+	if (dir[dir.size() - 1] != '/') dir += '/';
+
+	Cartridge c;
+	loadCart(c, rom, dir);
+	std::string const sav = c.saveBasePath() + ".sav";
+	std::remove(sav.c_str());
+
+	CHECK(!c.saveSavedataIfChanged());              // nothing changed since load
+	CHECK(fileSize(sav) == -1);
+
+	c.mbcWrite(0x0000, 0x0A);                       // game enables cartridge RAM
+	unsigned char *sram = c.wsrambankptr();
+	sram[0xA000 + 5] = 0x42;                        // ... and saves something
+
+	CHECK(c.saveSavedataIfChanged());               // written
+	CHECK(fileSize(sav) > 0);
+	CHECK(byteAt(sav, 5) == 0x42);
+	CHECK(fileSize(sav + ".tmp") == -1);            // temp file renamed away
+	CHECK(!c.saveSavedataIfChanged());              // not written again
+
+	sram[0xA000 + 6] = 0x99;
+	CHECK(c.saveSavedataIfChanged());
+	CHECK(byteAt(sav, 6) == 0x99);
+
+	Cartridge c2;                                   // "power on again"
+	loadCart(c2, rom, dir);
+	c2.mbcWrite(0x0000, 0x0A);
+	CHECK(c2.wsrambankptr()[0xA000 + 5] == 0x42);
+	CHECK(c2.wsrambankptr()[0xA000 + 6] == 0x99);
+	CHECK(!c2.saveSavedataIfChanged());
+
+	std::printf(failures ? "\n%d teste(s) falharam\n" : "\nTodos os testes passaram\n", failures);
+	return failures ? 1 : 0;
+}
