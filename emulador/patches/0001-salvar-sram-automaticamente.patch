+// MeuPocketGB: write to "<path>.tmp", fsync, then rename over the real file.
+// A power cut (the PocketGo switch cuts power instantly) then leaves either
+// the old save or the new one on the card, never a half-written file.
+static bool writeFileAtomic(std::string const &path, unsigned char const *data, std::size_t size) {
+	std::string const tmp = path + ".tmp";
+	std::FILE *f = std::fopen(tmp.c_str(), "wb");
+	if (!f)
+		return false;
+
+	bool ok = std::fwrite(data, 1, size, f) == size;
+	ok = std::fflush(f) == 0 && ok;
+	ok = fsync(fileno(f)) == 0 && ok;
+	ok = std::fclose(f) == 0 && ok;
+	if (!ok || std::rename(tmp.c_str(), path.c_str()) != 0) {
+		std::remove(tmp.c_str());
+		return false;
+	}
+
+	std::string dir = path;
+	std::string::size_type const slash = dir.rfind('/');
+	dir = slash == std::string::npos ? "." : dir.substr(0, slash ? slash : 1);
+	int const dfd = open(dir.c_str(), O_RDONLY);
+	if (dfd >= 0) {
+		fsync(dfd);
+		close(dfd);
+	}
+
+	return true;
+}
+
+void Cartridge::rememberSavedata() {
+	lastSavedRam_.assign(memptrs_.rambankdata(), memptrs_.rambankdataend());
+	lastSavedRtc_ = rtc_.baseTime();
 }
 
 void Cartridge::saveSavedata() {
 	std::string const &sbp = saveBasePath();
 
 	if (hasBattery(memptrs_.romdata()[0x147])) {
-		std::ofstream file((sbp + ".sav").c_str(), std::ios::binary | std::ios::out);
-		file.write(reinterpret_cast<char const *>(memptrs_.rambankdata()),
-		           memptrs_.rambankdataend() - memptrs_.rambankdata());
+		writeFileAtomic(sbp + ".sav", memptrs_.rambankdata(),
+		                memptrs_.rambankdataend() - memptrs_.rambankdata());
 	}
 
 	if (hasRtc(memptrs_.romdata()[0x147])) {
-		std::ofstream file((sbp + ".rtc").c_str(), std::ios::binary | std::ios::out);
 		unsigned long const basetime = rtc_.baseTime();
-		file.put(basetime >> 24 & 0xFF);
-		file.put(basetime >> 16 & 0xFF);
-		file.put(basetime >>  8 & 0xFF);
-		file.put(basetime       & 0xFF);
+		unsigned char const rtcdata[4] = {
+			static_cast<unsigned char>(basetime >> 24 & 0xFF),
+			static_cast<unsigned char>(basetime >> 16 & 0xFF),
+			static_cast<unsigned char>(basetime >>  8 & 0xFF),
+			static_cast<unsigned char>(basetime       & 0xFF)
+		};
+		writeFileAtomic(sbp + ".rtc", rtcdata, sizeof rtcdata);
 	}
+
+	rememberSavedata();
+}
+
+bool Cartridge::saveSavedataIfChanged() {
+	unsigned char const type = memptrs_.romdata()[0x147];
+	if (!hasBattery(type) && !hasRtc(type))
+		return false;
+
+	std::size_t const size = memptrs_.rambankdataend() - memptrs_.rambankdata();
+	bool const ramChanged = hasBattery(type) && size != 0
+		&& (lastSavedRam_.size() != size
+		    || std::memcmp(&lastSavedRam_[0], memptrs_.rambankdata(), size) != 0);
+	bool const rtcChanged = hasRtc(type) && lastSavedRtc_ != rtc_.baseTime();
+
+	if (!ramChanged && !rtcChanged)
+		return false;
+
+	saveSavedata();
+	return true;
 }
 
