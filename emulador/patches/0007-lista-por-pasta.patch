+static std::string mpgb_cfg_path() { return homedir + "/.gambatte/meupocketgb.cfg"; }
+
+static void mpgb_load_list_mode() {
+    mpgb_list_by_folder = 0;
+    FILE *f = fopen(mpgb_cfg_path().c_str(), "r");
+    if (!f)
+        return;
+    char line[128];
+    while (fgets(line, sizeof line, f))
+        if (strncmp(line, "lista=pastas", 12) == 0)
+            mpgb_list_by_folder = 1;
+    fclose(f);
+}
+
+static void mpgb_save_list_mode() {
+    std::string path = mpgb_cfg_path(), tmp = path + ".tmp";
+    FILE *f = fopen(tmp.c_str(), "w");
+    if (!f)
+        return;
+    fprintf(f, "lista=%s\n", mpgb_list_by_folder ? "pastas" : "tudo");
+    fclose(f);
+    mpgb_commit_file(tmp, path);
+}
+
+// "GB" -> "Game Boy", "GBC" -> "Game Boy Color", other folders keep their name
+static std::string mpgb_folder_label(const std::string &dir) {
+    std::string n = mpgb_basename(dir);
+    if (strcasecmp(n.c_str(), "GB") == 0) return "Game Boy";
+    if (strcasecmp(n.c_str(), "GBC") == 0) return "Game Boy Color";
+    return n;
+}
+
+static bool mpgb_folder_has_roms(const std::string &dir) {
+    DIR *d = opendir(dir.c_str());
+    if (!d)
+        return false;
+    bool found = false;
+    struct dirent *e;
+    while (!found && (e = readdir(d)) != NULL)
+        if (e->d_name[0] != '.' && mpgb_is_rom(e->d_name))
+            found = true;
+    closedir(d);
+    return found;
+}
+
+// one folder: its subfolders with games (only at the top, as "path/") then its games
+static void mpgb_scan_folder(const std::string &dir, bool with_folders) {
+    std::vector<std::string> folders, files;
+    DIR *d = opendir(dir.c_str());
+    if (!d)
+        return;
+    struct dirent *e;
+    while ((e = readdir(d)) != NULL) {
+        if (e->d_name[0] == '.')
+            continue;
+        std::string full = dir + "/" + e->d_name;
+        struct stat st;
+        if (stat(full.c_str(), &st) != 0)
+            continue;
+        if (S_ISDIR(st.st_mode)) {
+            if (with_folders && mpgb_folder_has_roms(full))
+                folders.push_back(full + "/");
+        } else if (S_ISREG(st.st_mode) && mpgb_is_rom(e->d_name)) {
+            files.push_back(full);
+        }
+    }
+    closedir(d);
+    std::sort(folders.begin(), folders.end());
+    std::sort(files.begin(), files.end(), mpgb_less);
+    mpgb_roms.insert(mpgb_roms.end(), folders.begin(), folders.end());
+    mpgb_roms.insert(mpgb_roms.end(), files.begin(), files.end());
+}
+
+static void mpgb_cb_list_back(menu_t *menu) {
+    if (mpgb_list_by_folder && !mpgb_list_dir.empty()) { // B inside a folder: go up
+        mpgb_highlight = mpgb_list_dir + "/";
