+
+// write+fsync a temporary file, then rename it over the real one
+static bool mpgb_commit_file(const std::string &tmp, const std::string &path) {
+    int fd = open(tmp.c_str(), O_RDONLY);
+    if (fd < 0)
+        return false;
+    fsync(fd);
+    close(fd);
+    if (rename(tmp.c_str(), path.c_str()) != 0)
+        return false;
+    std::string dir = path.substr(0, path.rfind('/'));
+    fd = open(dir.c_str(), O_RDONLY);
+    if (fd >= 0) {
+        fsync(fd);
+        close(fd);
+    }
+    return true;
+}
+
+static void mpgb_remember_game(const std::string &rompath) {
+    std::string path = mpgb_last_game_file(), tmp = path + ".tmp";
+    FILE *f = fopen(tmp.c_str(), "w");
+    if (!f)
         return;
