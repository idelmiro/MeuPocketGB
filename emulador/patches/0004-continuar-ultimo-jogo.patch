+
+static std::string mpgb_read_last_game() {
+    std::string rom;
+    FILE *f = fopen(mpgb_last_game_file().c_str(), "r");
+    if (!f)
+        return rom;
+    char buf[1024];
+    if (fgets(buf, sizeof buf, f)) {
+        rom = buf;
+        while (!rom.empty() && (rom[rom.size() - 1] == '\n' || rom[rom.size() - 1] == '\r'))
+            rom.erase(rom.size() - 1);
+    }
+    fclose(f);
+    return rom;
+}
