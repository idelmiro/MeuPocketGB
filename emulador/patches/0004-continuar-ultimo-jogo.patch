+static std::string mpgb_resume_state_path() {
+    std::string p = gambatte_p->getSaveStatePath(0); // <saves>/<game>_0.gqs
+    std::string::size_type at = p.rfind("_0.gqs");
+    if (at == std::string::npos)
+        return std::string();
+    return p.substr(0, at) + "_continuar.gqs";
+}
