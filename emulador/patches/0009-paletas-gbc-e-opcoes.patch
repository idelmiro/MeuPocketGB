+#ifdef MEUPOCKETGB
+#include "mpgb_paletas.h"
+// "GBC:<id>": one of the GBC boot-screen palettes; "GBC:AUTO": the one the GBC
+// picked for this title (header title), or its default. Returns false if not GBC:.
+static bool mpgb_load_gbc_palette(const std::string &name) {
+	if (name.compare(0, 4, "GBC:") != 0)
+		return false;
+	std::string id = name.substr(4);
+	const uint32_t *c = mpgb_paleta_gbc_padrao;
+	if (id == "AUTO") {
+		std::string title = gambatte_p->romTitle();
+		for (int i = 0; i < MPGB_N_PALETAS_TITULO; ++i)
+			if (title == mpgb_paletas_titulo[i].titulo)
+				c = mpgb_paletas_titulo[i].c;
+	} else {
+		for (int i = 0; i < MPGB_N_PALETAS_GBC; ++i)
+			if (id == mpgb_paletas_gbc[i].id)
+				c = mpgb_paletas_gbc[i].c;
+	}
+	for (int i = 0; i < 3; ++i)          // background, sprites 0, sprites 1
+		for (int k = 0; k < 4; ++k)
+			gambatte_p->setDmgPaletteColor(i, k, c[i * 4 + k]);
+	set_menu_palette(c[0], c[1], c[2], c[3]);
+	return true;
+}
+#endif
