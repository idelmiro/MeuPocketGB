+// MPGB_QUADROS="300,301": saves those game frames (counted from the first one drawn)
+void mpgb_test_game_frame() {
+	static int n = 0;
+	++n;
+	const char *dir = getenv("MPGB_CAPTURAS"), *list = getenv("MPGB_QUADROS");
+	if (!dir || !list || !screen)
+		return;
+	std::string l = std::string(",") + list + ",";
+	char key[16];
+	snprintf(key, sizeof key, ",%d,", n);
+	if (l.find(key) == std::string::npos)
+		return;
+	char path[512];
+	snprintf(path, sizeof path, "%s/jogo-%04d.bmp", dir, n);
+	SDL_SaveBMP(screen, path);
 }
 
