# MeuPocketGB: applied on top of the MiyooCFW kernel defconfig ("miyoo").
#
# Mounting the btrfs MAIN partition loads raid6_pq, which by default
# benchmarks every RAID6 routine before choosing one: ~1.2 s on the
# PocketGo at every boot (dmesg "raid6: int32x8 gen() ..."). The card has
# no RAID, so just take the first routine without measuring.
# CONFIG_RAID6_PQ_BENCHMARK is not set

# Input events (/dev/input/event*) built in, not a module nobody loads: the
# emulator reads whether SELECT is held at power-on (open the game list
# instead of continuing the last game). Built in = no modprobe at boot.
CONFIG_INPUT_EVDEV=y
